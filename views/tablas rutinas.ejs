<%- include('partials/header') %>

<link rel="stylesheet" href="/css/rutinas.css" />
<title>Generador de Rutinas</title>

  <main class="form-section">
  <div class="container">
    <h2>Rutina de Gimnasio: Push / Pull / Legs - 5 días</h2>
    <p>Distribución de ejercicios por día, con series y repeticiones recomendadas.</p>

    <table class="routine-table">
      <thead>
        <tr>
          <th>Día</th>
          <th>Ejercicio</th>
          <th>Series</th>
          <th>Repeticiones</th>
        </tr>
      </thead>
      <tbody>
        <tr><td rowspan="5">Lunes (Push)</td><td>Press de banca</td><td>4</td><td>8-10</td></tr>
        <tr><td>Press militar con barra</td><td>4</td><td>10-12</td></tr>
        <tr><td>Fondos en paralelas</td><td>3</td><td>10-12</td></tr>
        <tr><td>Elevaciones laterales</td><td>3</td><td>12-15</td></tr>
        <tr><td>Extensiones de tríceps</td><td>3</td><td>12-15</td></tr>

        <tr><td rowspan="5">Martes (Pull)</td><td>Dominadas</td><td>4</td><td>8-10</td></tr>
        <tr><td>Remo con barra</td><td>4</td><td>10-12</td></tr>
        <tr><td>Jalón al pecho</td><td>3</td><td>12-15</td></tr>
        <tr><td>Face pulls</td><td>3</td><td>15</td></tr>
        <tr><td>Curl de bíceps con barra</td><td>3</td><td>10-12</td></tr>

        <tr><td rowspan="5">Miércoles (Piernas)</td><td>Sentadillas</td><td>4</td><td>8-10</td></tr>
        <tr><td>Prensa de piernas</td><td>4</td><td>12</td></tr>
        <tr><td>Elevación de talones (gemelos)</td><td>3</td><td>15-20</td></tr>
        <tr><td>Peso muerto rumano</td><td>3</td><td>10</td></tr>
        <tr><td>Zancadas con mancuernas</td><td>3</td><td>12 por pierna</td></tr>

        <tr><td rowspan="5">Jueves (Push)</td><td>Press inclinado con mancuernas</td><td>4</td><td>8-10</td></tr>
        <tr><td>Press Arnold</td><td>4</td><td>10-12</td></tr>
        <tr><td>Press cerrado</td><td>3</td><td>10-12</td></tr>
        <tr><td>Elevaciones frontales</td><td>3</td><td>12-15</td></tr>
        <tr><td>Patada de tríceps</td><td>3</td><td>12-15</td></tr>

        <tr><td rowspan="5">Viernes (Pull)</td><td>Remo con mancuerna</td><td>4</td><td>10-12</td></tr>
        <tr><td>Jalón al rostro</td><td>4</td><td>15</td></tr>
        <tr><td>Curl martillo</td><td>3</td><td>12</td></tr>
        <tr><td>Peso muerto</td><td>4</td><td>6-8</td></tr>
        <tr><td>Curl concentrado</td><td>3</td><td>12-15</td></tr>
      </tbody>
    </table>
  </div>
</main>

