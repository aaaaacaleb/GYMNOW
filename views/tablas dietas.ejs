  <main class="form-section">
  <div class="container">
    <h2>Plan de Alimentación Semanal - Volumen Limpio</h2>
    <p>Distribución de comidas ricas en nutrientes para ganar masa muscular de forma saludable.</p>

    <table class="routine-table">
      <thead>
        <tr>
          <th>Día</th>
          <th>Comida</th>
          <th>Ejemplo</th>
        </tr>
      </thead>
      <tbody>
        <!-- Lunes -->
        <tr><td rowspan="5">Lunes</td><td>Desayuno</td><td>Avena con plátano, nueces y claras de huevo</td></tr>
        <tr><td>Snack</td><td>Yogur griego natural con almendras</td></tr>
        <tr><td>Comida</td><td>Arroz integral con pechuga de pollo y verduras salteadas</td></tr>
        <tr><td>Merienda</td><td>Batido de proteína + pan integral con aguacate</td></tr>
        <tr><td>Cena</td><td>Salmón a la plancha con quinoa y brócoli</td></tr>

        <!-- Martes -->
        <tr><td rowspan="5">Martes</td><td>Desayuno</td><td>Tostadas integrales con huevo y aguacate</td></tr>
        <tr><td>Snack</td><td>Fruta (manzana) + puñado de nueces</td></tr>
        <tr><td>Comida</td><td>Lentejas con arroz y carne magra</td></tr>
        <tr><td>Merienda</td><td>Queso cottage con fruta y avena</td></tr>
        <tr><td>Cena</td><td>Ensalada con atún, huevo cocido y aceite de oliva</td></tr>

        <!-- Miércoles -->
        <tr><td rowspan="5">Miércoles</td><td>Desayuno</td><td>Pan integral con mantequilla de maní y plátano</td></tr>
        <tr><td>Snack</td><td>Batido de proteína + semillas de chía</td></tr>
        <tr><td>Comida</td><td>Pasta integral con carne de res magra y verduras</td></tr>
        <tr><td>Merienda</td><td>Yogur natural + granola sin azúcar</td></tr>
        <tr><td>Cena</td><td>Pollo al horno con puré de papa y ensalada</td></tr>

        <!-- Jueves -->
        <tr><td rowspan="5">Jueves</td><td>Desayuno</td><td>Hotcakes de avena con miel natural y huevo cocido</td></tr>
        <tr><td>Snack</td><td>Fruta + mix de frutos secos</td></tr>
        <tr><td>Comida</td><td>Arroz, huevo, aguacate y carne magra</td></tr>
        <tr><td>Merienda</td><td>Batido con avena, leche y proteína</td></tr>
        <tr><td>Cena</td><td>Filete de pescado con batata y espárragos</td></tr>

        <!-- Viernes -->
        <tr><td rowspan="5">Viernes</td><td>Desayuno</td><td>Omelette de claras, avena y fruta</td></tr>
        <tr><td>Snack</td><td>Yogur + nueces</td></tr>
        <tr><td>Comida</td><td>Pollo a la plancha, arroz y ensalada verde</td></tr>
        <tr><td>Merienda</td><td>Pan integral con queso panela</td></tr>
        <tr><td>Cena</td><td>Pechuga de pavo con quinoa y verduras al vapor</td></tr>

        <!-- Sábado -->
        <tr><td rowspan="5">Sábado</td><td>Desayuno</td><td>Pan integral con huevo revuelto y fruta</td></tr>
        <tr><td>Snack</td><td>Batido de proteína con leche vegetal</td></tr>
        <tr><td>Comida</td><td>Tacos de carne magra con guacamole</td></tr>
        <tr><td>Merienda</td><td>Plátano con crema de cacahuate</td></tr>
        <tr><td>Cena</td><td>Pasta integral con atún y verduras</td></tr>

        <!-- Domingo -->
        <tr><td rowspan="5">Domingo</td><td>Desayuno</td><td>Hotcakes integrales con fruta y miel</td></tr>
        <tr><td>Snack</td><td>Mix de frutos secos y fruta</td></tr>
        <tr><td>Comida</td><td>Carne asada con arroz integral y ensalada</td></tr>
        <tr><td>Merienda</td><td>Yogur natural con semillas</td></tr>
        <tr><td>Cena</td><td>Omelette con vegetales y pan tostado integral</td></tr>
      </tbody>
    </table>
